{
  "manifest_version": 3,
  "name": "Cookie Porter",
  "version": "1.0.0",
  "description": "Export and import cookies between browsers or after formatting your computer.",
  "permissions": ["cookies", "tabs", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Porter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
